
# Copier vers .env.local pour le développement local.
# Pour obtenir les clés locales, démarrer Supabase puis exécuter : supabase status --output env
# Ne jamais committer de vraies clés ou secrets.

# URL canonique utilisée dans les liens de confirmation et d'invitation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuration publique Supabase (la clé publishable est destinée au client).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=remplacer-par-la-cle-publishable-locale

# Optionnel : nécessaire aux endpoints serveur d'upload privé uniquement.
# Ne jamais exposer cette clé dans une variable NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-locale

# Optionnel : e-mails d'invitation. Laisser non configuré pour le développement
# sans envoi ; l'application permet alors de révéler un lien manuel à l'invitant.
RESEND_API_KEY=remplacer-par-la-cle-resend-de-test
RESEND_FROM_EMAIL="PolyGest <invitations@example.test>"

# Verrou indicatif uniquement : le code serveur maintient actuellement
# le module documentaire désactivé, même si cette variable est modifiée.
# Ne pas tenter de l'activer avant livraison et tests du scanner serveur.
DOCUMENT_SCANNER_ENABLED=false


# Modèle de variables d'environnement
# Valeurs fictives uniquement : ne jamais mettre de vrais secrets dans Git.
# Pour le développement local, copier ce fichier vers .env.local.

# Environnement
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL local — valeurs de développement uniquement
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/gestion_db

# Secret de session local — remplacer par une valeur aléatoire
NEXTAUTH_SECRET=remplacer-par-un-secret-aleatoire-local

# Supabase (optionnel, configuration à confirmer)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=remplacer-par-la-cle-publishable-de-test

# Secret réservé au serveur : ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-de-test

# En staging et en production, utiliser des identifiants distincts,
# configurés dans le gestionnaire de secrets de l'hébergeur.

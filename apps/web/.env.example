# Modèle de variables d'environnement. Copier vers `.env.local` (jamais commité).
# Ne mettre ici AUCUNE vraie valeur : uniquement des valeurs fictives.
# Les services ci-dessous (Supabase) sont une proposition, pas une décision validée.

# URL publique de l'application (développement local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (à confirmer) ---
# Valeurs publiques côté navigateur
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-anon-de-test

# Secret serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_, ne jamais exposer au client
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-de-test

# Les environnements staging et production utilisent des clés distinctes,
# stockées dans le gestionnaire de secrets de l'hébergeur, jamais dans Git.
